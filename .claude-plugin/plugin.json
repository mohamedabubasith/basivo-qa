{
  "name": "basivo-qa",
  "version": "0.2.0",
  "description": "Test a web app in a real browser and hand the verdict to Claude, so the bug gets fixed in the same session instead of written up in a report.",
  "author": {
    "name": "Basivo",
    "url": "https://basivo.in"
  },
  "homepage": "https://github.com/mohamedabubasith/basivo-qa",
  "repository": "https://github.com/mohamedabubasith/basivo-qa",
  "license": "MIT",
  "keywords": [
    "qa",
    "testing",
    "playwright",
    "browser",
    "agent",
    "verdict"
  ],
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.80",
        "--isolated",
        "--headless",
        "--output-dir",
        ".qa/run"
      ]
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/after-edit.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/before-stop.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
